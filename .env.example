# QuickPeek frontend environment
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# EXPO_PUBLIC_* vars are bundled into the app — only put publishable (public)
# keys here, never secrets.
#
# NOTE: for device builds (EAS Build / TestFlight), these values are baked in
# at build time from `eas.json` → build profile `env`, NOT from this file.
# This file only affects local `expo start` development.

# Stripe publishable key (safe to embed in the app). Get it from
# https://dashboard.stripe.com → Developers → API keys → "Publishable key"
# (pk_test_... while developing/staging). Free account, test mode is free.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional API base-URL override (the app otherwise derives it from the Metro
# host). Example: http://192.168.1.10:3000
# In device builds this MUST point at the deployed API, e.g.
# https://quickpeek-api.onrender.com — set via eas.json, not here.
# EXPO_PUBLIC_API_URL=

# ─── Social sign-in (OAuth) ────────────────────────────────────────────────
# All values here are PUBLIC client IDs / app IDs — safe to ship in the bundle.
# Secrets live on the backend (see quickpeek_backend/.env.example). Leave any
# provider you haven't configured yet blank; the UI will throw a clear error
# only when the user actually taps that provider's button.
#
# Google — Web Client ID (Credentials → OAuth 2.0 Client ID → Web application).
# Used for web dev (`http://localhost:8081/oauthredirect`) and Android until a
# dedicated Android OAuth client exists.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google — iOS Client ID (Credentials → OAuth 2.0 Client ID → iOS). Required
# for TestFlight / App Store builds. Download the plist Google offers after
# creation — it contains both CLIENT_ID and REVERSED_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Google — iOS reversed client ID URL scheme from the same plist
# (`REVERSED_CLIENT_ID` key, e.g. com.googleusercontent.apps.1234567890-abc…).
# Registered as an extra URL scheme via app.config.js so Google can redirect
# back to the app after sign-in.
EXPO_PUBLIC_GOOGLE_IOS_REVERSED_CLIENT_ID=

# Apple — Sign In with Apple "Services ID" (NOT your iOS App ID). Configure
# the Services ID at developer.apple.com → Certificates, Identifiers &
# Profiles → Identifiers → Services ID → Sign In with Apple, and register
# the same redirect URI under "Return URLs". Used on Android + web.
EXPO_PUBLIC_APPLE_SERVICE_ID=

# Facebook — App ID (developers.facebook.com → My Apps → your app → Settings
# → Basic → App ID). Enable "Facebook Login" and add the OAuth redirect URI
# to Valid OAuth Redirect URIs.
EXPO_PUBLIC_FACEBOOK_APP_ID=
