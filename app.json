{
  "expo": {
    "name": "quickpeek",
    "slug": "quickpeek",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "quickpeekfrontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chingsley.quickpeek-frontend",
      "infoPlist": {
        "MetroPackagerHost": "localhost",
        "MetroUseLanPackager": false,
        "NSBonjourServices": [
          "_react-native._tcp",
          "_react-native._tcp"
        ],
        "NSLocalNetworkUsageDescription": "Quickpeek needs access to your local network to connect to the Metro development server during development.",
        "NSLocationWhenInUseUsageDescription": "If you turn on location sharing, Quickpeek uses your location so nearby users can find you as a responder.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.chingsley.quickpeek"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "If you turn on location sharing, Quickpeek uses your location so nearby users can find you as a responder."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "83eb8615-b904-4d52-ac2c-fd4d498ff6d2"
      }
    },
    "owner": "chingsley"
  }
}
